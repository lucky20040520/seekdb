load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "fts_parser_cases",
    srcs = [
        "test_fts_daat.cpp",
        "test_fts_dictionary_cache.cpp",
        "test_fts_english_normalizer.cpp",
        "test_fts_parser.cpp",
    ],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/storage:storage_unit_test_interface",
    ],
)

cc_test(
    name = "test_fts_parser",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime; select rules_cc's $ORIGIN rpath.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":fts_parser_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
